# Database
# PostgreSQL connection string
# Update the password with your actual PostgreSQL password
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shirt_canary?schema=public"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production-minimum-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Stripe Webhook Secret
# Get this from: https://dashboard.stripe.com/webhooks
# After creating a webhook endpoint for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Application URL
# Used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
